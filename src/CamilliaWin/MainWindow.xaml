<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CamilliaWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Camillia">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <StackPanel Padding="24" Spacing="16">
        <TextBlock Text="Camillia" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Name="CoreInfoText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="NameBox" PlaceholderText="Your name" Width="260" KeyDown="NameBox_KeyDown" />
            <Button Content="Greet" Style="{StaticResource AccentButtonStyle}" Click="Greet_Click" />
        </StackPanel>

        <TextBlock x:Name="ResultText" IsTextSelectionEnabled="True" />
    </StackPanel>
</Window>
